{
  "name": "@crud/api",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun x drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "test": "bun test",
    "test:unit": "bun --no-env-file test ./tests/unit",
      "test:integration": "bun --env-file=.env.test --preload ./tests/helpers/test-env.ts test ./tests/integration",
      "db:migrate:test": "bun --env-file=.env.test --preload ./tests/helpers/test-env.ts src/db/migrate.ts",

    "auth:seed": "bun src/scripts/seed-account.ts",
    "auth:cleanup": "bun src/scripts/cleanup-auth.ts"
  },
  "dependencies": {
    "@crud/contracts": "workspace:*",
    "@hono/bun": "1.0.0",
    "@hono/zod-validator": "0.9.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}